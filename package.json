{
  "name": "vue3-base",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "开箱即用的 Vue 3 + Vite + TypeScript 后台管理基础脚手架",
  "author": "WJH <r2@mrwang.pw>",
  "license": "MIT",
  "homepage": "https://github.com/wjh-cloud/vue3-base#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjh-cloud/vue3-base.git"
  },
  "bugs": {
    "url": "https://github.com/wjh-cloud/vue3-base/issues"
  },
  "keywords": [
    "vue3",
    "vite",
    "typescript",
    "element-plus",
    "tailwindcss",
    "admin",
    "scaffold",
    "template"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "lint-staged": {
    "src/**/*.{js,vue,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "esbuild",
      "vue-demi"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tailwindcss/vite": "^4.1.13",
    "axios": "^1.7.9",
    "element-plus": "^2.9.1",
    "pinia": "^2.2.6",
    "pinia-plugin-persistedstate": "^4.2.0",
    "sass": "^1.83.0",
    "tailwindcss": "^4.1.13",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.9.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.14.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "npm-run-all2": "^7.0.1",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "unplugin-auto-import": "^0.18.6",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^6.0.1",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^7.6.5",
    "vite-plugin-vue-setup-extend": "^0.4.0",
    "vue-tsc": "^2.1.10"
  }
}
